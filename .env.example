# Label Studio demo - environment variables. All are optional.
# `npm run dev` / `npm run demo` sets DEMO_MODE, LABEL_PORT and LABEL_DATA_DIR itself.

# 1 = virtual "Demo PDF printer" instead of the Windows printer list, PDF preview instead of the spooler
DEMO_MODE=
# Port of the label server (default 5180; Vite proxies /api to it)
LABEL_PORT=
# Folder for the SQLite database (default ./Data; the demo uses ./.demo_data)
LABEL_DATA_DIR=
# Chrome / Chromium used for headless PDF rendering (auto-detected if empty,
# including Playwright's Chromium from `npx playwright install chromium`)
CHROME_PATH=
PUPPETEER_EXECUTABLE_PATH=
PLAYWRIGHT_BROWSERS_PATH=
